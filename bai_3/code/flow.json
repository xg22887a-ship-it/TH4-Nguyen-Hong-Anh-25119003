    "tach"
   ]
  ]
 },
 {
  "id": "tach",
  "type": "function",
  "z": "flow1",
  "name": "tách trường",
  "func": "const p = msg.payload;\nreturn [\n  {payload: p.temp, topic: 'Nhiệt độ (°C)'},\n  {payload: p.hum, topic: 'Độ ẩm (%)'},\n  {payload: p.led ? 1 : 0},\n  {payload: p.rssi}\n];",
  "outputs": 4,
  "x": 330,
  "y": 120,
  "wires": [
   [
    "gTemp",
    "chart"
   ],
   [
    "gHum",
    "chart"
   ],
   [
    "denLed"
   ],
   [
    "songWifi"
   ]
  ]
 },
