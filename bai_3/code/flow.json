 {
  "id": "denLed",
  "type": "ui_template",
  "z": "flow1",
  "group": "grpDk",
  "name": "Đèn LED ảo (tự thêm)",
  "order": 1,
  "width": 6,
  "height": 2,
  "format": "<div style=\"display:flex;align-items:center;justify-content:center;gap:20px;padding:8px 0\">\n  <div ng-style=\"{'width':'72px','height':'72px','border-radius':'50%','transition':'all .3s',\n    'background': msg.payload ? 'radial-gradient(circle at 35% 35%,#fffde7,#ffd54f 45%,#f9a825 80%)' : 'radial-gradient(circle at 35% 35%,#757575,#424242 70%)',\n    'box-shadow': msg.payload ? '0 0 28px 10px rgba(255,213,79,.85)' : 'inset 0 0 8px rgba(0,0,0,.6)'}\"></div>\n  <div style=\"font-size:20px;font-weight:bold\">{{ msg.payload ? 'LED ĐANG BẬT' : 'LED ĐANG TẮT' }}</div>\n</div>",
  "storeOutMessages": true,
  "fwdInMessages": false,
  "resendOnRefresh": true,
  "templateScope": "local",
  "x": 580,
  "y": 200,
  "wires": [
   []
  ]
 },
 {
  "id": "songWifi",
  "type": "ui_template",
  "z": "flow1",
  "group": "grpSo",
  "name": "Sóng WiFi RSSI (tự thêm)",
  "order": 4,
  "width": 6,
  "height": 2,
  "format": "<div style=\"display:flex;align-items:flex-end;justify-content:center;gap:18px;padding:6px 0\">\n  <div style=\"display:flex;align-items:flex-end;gap:5px;height:56px\">\n    <div ng-repeat=\"i in [1,2,3,4]\" ng-style=\"{'width':'14px','height':(i*14)+'px','border-radius':'3px','transition':'background .3s',\n      'background': i <= (msg.payload >= -55 ? 4 : msg.payload >= -67 ? 3 : msg.payload >= -75 ? 2 : msg.payload >= -85 ? 1 : 0)\n        ? (msg.payload >= -67 ? '#1baf7a' : msg.payload >= -75 ? '#eda100' : '#e34948') : '#9e9e9e55'}\"></div>\n  </div>\n  <div style=\"text-align:left\">\n    <div style=\"font-size:20px;font-weight:bold\">{{msg.payload}} dBm</div>\n    <div style=\"opacity:.75\">{{ msg.payload >= -55 ? 'Rất mạnh' : msg.payload >= -67 ? 'Mạnh' : msg.payload >= -75 ? 'Trung bình' : msg.payload >= -85 ? 'Yếu' : 'Rất yếu' }}</div>\n  </div>\n</div>",
  "storeOutMessages": true,
  "fwdInMessages": false,
  "resendOnRefresh": true,
  "templateScope": "local",
  "x": 590,
  "y": 240,
  "wires": [
   []
  ]
 }
